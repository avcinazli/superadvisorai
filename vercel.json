{
  "version": 2,
  "builds": [
    { "src": "app/public/landing.html", "use": "@vercel/static" },
    { "src": "app/public/fiyatlar.html", "use": "@vercel/static" },
    { "src": "app/public/yapay-zeka-danismanligi.html", "use": "@vercel/static" },
    { "src": "app/public/kurumsal-yapay-zeka-egitimi.html", "use": "@vercel/static" },
    { "src": "app/public/robots.txt", "use": "@vercel/static" },
    { "src": "app/public/sitemap.xml", "use": "@vercel/static" },
    { "src": "app/public/llms.txt", "use": "@vercel/static" },
    { "src": "app/public/assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(fiyatlar|yapay-zeka-danismanligi|kurumsal-yapay-zeka-egitimi)\\.html", "status": 301, "headers": { "Location": "/$1" } },
    { "src": "/(fiyatlar|yapay-zeka-danismanligi|kurumsal-yapay-zeka-egitimi)/?", "dest": "/app/public/$1.html" },
    { "src": "/(robots\\.txt|llms\\.txt)", "headers": { "Content-Type": "text/plain; charset=utf-8" }, "dest": "/app/public/$1" },
    { "src": "/sitemap\\.xml", "headers": { "Content-Type": "application/xml; charset=utf-8" }, "dest": "/app/public/sitemap.xml" },
    { "src": "/assets/(.*)", "dest": "/app/public/assets/$1" },
    { "src": "/", "dest": "/app/public/landing.html" },
    { "src": "/(.*)", "status": 404, "dest": "/app/public/landing.html" }
  ]
}
